<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the macOS binaries that run wasmtime (vy-shell, vy-cli,
  vy-dev, vy-publish), signed with the hardened runtime that notarization
  requires (.github/workflows/release.yml, docs/RELEASING.md). wasmtime maps
  the code Cranelift compiles writable and then executable with mprotect,
  without MAP_JIT, which the hardened runtime allows only with this
  entitlement (principle 6: compile down, never interpret). vy-serve runs no
  module and is signed without it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
