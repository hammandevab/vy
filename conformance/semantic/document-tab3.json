    {"id": 85, "parent_id": 1, "role": 3, "role_name": "link", "x": 200, "y": 1192.25, "w": 199.43, "h": 18, "text": "Ladda ner mätdata (CSV)"},
    {"id": 86, "parent_id": 1, "role": 2, "role_name": "heading", "x": 200, "y": 1246.25, "w": 880, "h": 24, "text": "Noter"},
